# CircuitLens Environment Configuration

# Backend Host & Port
PORT=8000
HOST=127.0.0.1

# ngspice path (if not in PATH, specify exact path to binary)
# On Windows, e.g. c:/CircuitLens/tools/ngspice/bin/ngspice_con.exe or C:/Spice64/bin/ngspice.exe
NGSPICE_PATH=c:/CircuitLens/tools/ngspice/bin/ngspice_con.exe

# Local Gemma 4 provider (install Ollama, then run `ollama run gemma4:e2b`)
GEMMA_PROVIDER=ollama
GEMMA_MODEL_ID=gemma4:e2b
GEMMA_BASE_URL=http://127.0.0.1:11434
